{
  "name": "koko-backend",
  "private": true,
  "description": "Koko content backend: shared lesson schema, Supabase import/export scripts and the admin dashboard. The live PWA in the repo root does not use any of this.",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "admin"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "validate": "tsx scripts/validate-content.ts",
    "import": "tsx scripts/import-json.ts",
    "export": "tsx scripts/export-static.ts",
    "admin:dev": "npm run dev -w @koko/admin",
    "admin:build": "npm run build -w @koko/admin"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
