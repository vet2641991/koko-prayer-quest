    {
      "id": "d2",
      "who": "muhammad",
      "ar": "الأَوَّلُ مُشْتَاقٌ، هُوَ نَحِيفٌ.",
      "en": "The first is Mushtaq. He is thin."
    },
    {
      "id": "d3",
      "who": "fadl",
      "ar": "وَمَنِ الثَّانِي؟",
      "en": "And who is the second?"
    },
    {
      "id": "d4",
      "who": "muhammad",
      "ar": "الثَّانِي أَحْمَدُ، وَالثَّالِثُ أَنَسٌ، وَالرَّابِعُ صَالِحٌ.",
      "en": "The second is Ahmad, the third is Anas, and the fourth is Salih."
    },
    {
      "id": "d5",
      "who": "fadl",
      "ar": "مَنِ الخَامِسُ؟",
      "en": "Who is the fifth?"
    },
    {
      "id": "d6",
      "who": "muhammad",
      "ar": "الخَامِسُ بَهَاءٌ، وَالسَّادِسُ صَبْرِيٌّ، وَالسَّابِعُ عَاصِمٌ، وَالثَّامِنُ خَيْرِيٌّ، وَالتَّاسِعُ أَنَا.",
      "en": "The fifth is Bahaa, the sixth is Sabri, the seventh is Asim, the eighth is Khairi, and the ninth is me."
    },
    {
      "id": "d7",
      "who": "fadl",
      "ar": "وَمَنِ العَاشِرُ؟",
      "en": "And who is the tenth?"
    },
    {
      "id": "d8",
      "who": "muhammad",
      "ar": "أَنْتَ العَاشِرُ. أَنْتَ الأَخِيرُ.",
      "en": "You are the tenth. You are the last."
    },
    {
      "id": "d9",
      "who": "fadl",
      "ar": "أَنَا مَرِيضٌ.",
      "en": "I am sick."
    },
    {
