  "learn": [
    {
      "en": "This is Ha. A strong H from deep in the throat, like breathing on your glasses to clean them, but stronger!",
      "title": "Meet Ha!",
      "ar": "ح",
      "aud": "c-0-ar",
      "tr": "Ha"
    },
    {
      "en": "A curved shape like a reversed C or a sideways open bracket . No dots! Ha looks like a WAVE feel the breath flowing like a wave from your throat!",
      "title": "How to write Ha"
    },
    {
      "en": "With a fatha, Ha says “ha”.",
      "title": "Ha with fatha",
      "ar": "حَ",
      "aud": "c-2-ar"
    },
    {
      "en": "With a kasra, Ha says “he”.",
      "title": "Ha with kasra",
      "ar": "حِ",
      "aud": "c-3-ar"
    },
    {
      "en": "With a damma, Ha says “ho”.",
      "title": "Ha with damma",
      "ar": "حُ",
      "aud": "c-4-ar"
    },
    {
      "en": "“Life is beautiful”",
      "title": "Sentence of the lesson",
      "ar": "الْحَيَاةُ جَمِيلَة",
      "aud": "c-5-ar",
      "tr": "Al-Hayato Jamelah"
    }
