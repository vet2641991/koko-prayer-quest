      "ar": "سُكُون",
      "aud": "c-3-ar",
      "tr": "Sukoon"
    },
    {
      "en": "Shaddah: double · it doubles the letter sound.",
      "title": "Shaddah",
      "ar": "شَدَّة",
      "aud": "c-4-ar",
      "tr": "Shaddah"
    }
