  "learn": [
    {
      "en": "This is Ra. A rolled or trilled 'r' like Spanish 'r' in 'pero'. Tongue vibrates near the roof of mouth",
      "title": "Meet Ra!",
      "ar": "ر",
      "aud": "c-0-ar",
      "tr": "Ra"
    },
    {
      "en": "A gentle curved stroke like a small wave or the number 7 upside down. No dots. Ra flows like a RIVER curve and flow! Think 'R' for River!",
      "title": "How to write Ra"
    },
    {
      "en": "With a fatha, Ra says “ra”.",
      "title": "Ra with fatha",
      "ar": "رَ",
      "aud": "c-2-ar"
    },
    {
      "en": "With a kasra, Ra says “re”.",
      "title": "Ra with kasra",
      "ar": "رِ",
      "aud": "c-3-ar"
    },
    {
      "en": "With a damma, Ra says “ro”.",
      "title": "Ra with damma",
      "ar": "رُ",
      "aud": "c-4-ar"
    },
    {
      "en": "“The spring is beautiful”",
      "title": "Sentence of the lesson",
      "ar": "الرَّبِيعُ جَمِيلٌ",
      "aud": "c-5-ar",
      "tr": "Al-Rabeeʿo Jameelon"
    }
