  "learn": [
    {
      "en": "This is Zayn. Like 'z' in 'zero' or 'zoo'. A buzzing sound feel the vibration!",
      "title": "Meet Zayn!",
      "ar": "ز",
      "aud": "c-0-ar",
      "tr": "Zayn"
    },
    {
      "en": "Same shape as Ra but with a dot ON TOP. The dot buzzes above like a bee! Zayn is Ra with a dot like a BEE sitting on top, making the buzzing Z sound!",
      "title": "How to write Zayn"
    },
    {
      "en": "With a fatha, Zayn says “za”.",
      "title": "Zayn with fatha",
      "ar": "زَ",
      "aud": "c-2-ar"
    },
    {
      "en": "With a kasra, Zayn says “ze”.",
      "title": "Zayn with kasra",
      "ar": "زِ",
      "aud": "c-3-ar"
    },
    {
      "en": "With a damma, Zayn says “zo”.",
      "title": "Zayn with damma",
      "ar": "زُ",
      "aud": "c-4-ar"
    },
    {
      "en": "“The flower is beautiful”",
      "title": "Sentence of the lesson",
      "ar": "الزَّهْرَةُ جَمِيلَة",
      "aud": "c-5-ar",
      "tr": "Az-Zahrato Jameelah"
    }
