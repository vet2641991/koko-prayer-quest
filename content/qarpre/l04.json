  "learn": [
    {
      "en": "This is Baa. Like 'b' in 'book'. A strong lip sound press both lips together then release.",
      "title": "Meet Baa!",
      "ar": "ب",
      "aud": "c-0-ar",
      "tr": "Baa"
    },
    {
      "en": "A flat base line with a single dot BELOW it. Draw the line first, then add the dot. The dot under Ba looks like a BOAT Ba rides below the line!",
      "title": "How to write Baa"
    },
    {
      "en": "With a fatha, Baa says “ba”.",
      "title": "Baa with fatha",
      "ar": "بَ",
      "aud": "c-2-ar"
    },
    {
      "en": "With a kasra, Baa says “be”.",
      "title": "Baa with kasra",
      "ar": "بِ",
      "aud": "c-3-ar"
    },
    {
      "en": "With a damma, Baa says “bo”.",
      "title": "Baa with damma",
      "ar": "بُ",
      "aud": "c-4-ar"
    },
    {
      "en": "“This house is big”",
