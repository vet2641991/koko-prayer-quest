  "minutes": 10,
  "learn": [
    {
      "en": "This is Thaal. Like 'th' in 'that' or 'this' (voiced). Not like 'think' this is the voiced version!",
      "title": "Meet Thaal!",
      "ar": "ذ",
      "aud": "c-0-ar",
      "tr": "Thaal"
    },
    {
      "en": "Same shape as Dal but with a single dot ON TOP. Dot above = Thaal! Dhal is Dal with a dot like putting a 'hat' on Dal to change its sound!",
      "title": "How to write Thaal"
    },
    {
      "en": "With a fatha, Thaal says “tha”.",
      "title": "Thaal with fatha",
      "ar": "ذَ",
      "aud": "c-2-ar"
    },
    {
      "en": "With a kasra, Thaal says “the”.",
      "title": "Thaal with kasra",
      "ar": "ذِ",
      "aud": "c-3-ar"
    },
    {
      "en": "With a damma, Thaal says “tho”.",
      "title": "Thaal with damma",
      "ar": "ذُ",
      "aud": "c-4-ar"
    },
    {
      "en": "“The Gold is precious”",
