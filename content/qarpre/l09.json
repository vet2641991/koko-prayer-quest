  "minutes": 10,
  "learn": [
    {
      "en": "This is Khaa. Like the 'ch' in Scottish 'loch' or German 'Bach'. A raspy sound from the back of the throat.",
      "title": "Meet Khaa!",
      "ar": "خ",
      "aud": "c-0-ar",
      "tr": "Khaa"
    },
    {
      "en": "Same shape as Ha but with a single dot ON TOP. Dot above = Kha! Kha is Ha with a hat (a dot on top). The dot gives it its special raspy sound!",
      "title": "How to write Khaa"
    },
    {
      "en": "With a fatha, Khaa says “kha”.",
      "title": "Khaa with fatha",
      "ar": "خَ",
      "aud": "c-2-ar"
    },
    {
      "en": "With a kasra, Khaa says “khe”.",
      "title": "Khaa with kasra",
      "ar": "خِ",
      "aud": "c-3-ar"
    },
    {
      "en": "With a damma, Khaa says “kho”.",
      "title": "Khaa with damma",
      "ar": "خُ",
      "aud": "c-4-ar"
    },
    {
      "en": "“The Bread Is Fresh”",
