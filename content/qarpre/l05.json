  "learn": [
    {
      "en": "This is Ta. Like 't' in 'top'. Tongue touches the upper teeth a crisp, clear sound.",
      "title": "Meet Ta!",
      "ar": "ت",
      "aud": "c-0-ar",
      "tr": "Ta"
    },
    {
      "en": "Same shape as Ba but with TWO dots ABOVE. Draw the base line, then two dots on top. Ta has TWO dots on top like TWO eyes looking up to the sky!",
      "title": "How to write Ta"
    },
    {
      "en": "With a fatha, Ta says “ta”.",
      "title": "Ta with fatha",
      "ar": "تَ",
      "aud": "c-2-ar"
    },
    {
      "en": "With a kasra, Ta says “te”.",
      "title": "Ta with kasra",
      "ar": "تِ",
      "aud": "c-3-ar"
    },
    {
      "en": "With a damma, Ta says “to”.",
      "title": "Ta with damma",
      "ar": "تُ",
      "aud": "c-4-ar"
    },
    {
      "en": "“The apple is delicious”",
      "title": "Sentence of the lesson",
      "ar": "التُّفَّاحُ لَذِيذْ",
      "aud": "c-5-ar",
      "tr": "Al-Toffah Lathith"
    }
