  "learn": [
    {
      "en": "This is Tha. Like 'th' in 'three' or 'think'. Put your tongue between your teeth and blow air!",
      "title": "Meet Tha!",
      "ar": "ث",
      "aud": "c-0-ar",
      "tr": "Tha"
    },
    {
      "en": "Same base as Ba/Ta but with THREE dots above. Three dots = Tha! Tha has THREE dots, and 'three' starts with 'th' just like Tha's sound!",
      "title": "How to write Tha"
    },
    {
      "en": "With a fatha, Tha says “tha”.",
      "title": "Tha with fatha",
      "ar": "ثَ",
      "aud": "c-2-ar"
    },
    {
      "en": "With a kasra, Tha says “the”.",
      "title": "Tha with kasra",
      "ar": "ثِ",
      "aud": "c-3-ar"
    },
    {
      "en": "With a damma, Tha says “tho”.",
      "title": "Tha with damma",
      "ar": "ثُ",
      "aud": "c-4-ar"
    },
    {
      "en": "“The fox is smart”",
      "title": "Sentence of the lesson",
