  "minutes": 10,
  "learn": [
    {
      "en": "This is Ghain. Like the French 'r' in 'Paris' — a gargling sound from the back of the throat.",
      "title": "Meet Ghain!",
      "ar": "غ",
      "aud": "c-0-ar",
      "tr": "Ghain"
    },
    {
      "en": "Same shape as Ain but with a dot ON TOP. The dot distinguishes Ghain from Ain. Ghain is Ain with a dot like gargling water in your throat! Deep and rich sound.",
      "title": "How to write Ghain"
    },
    {
      "en": "With a fatha, Ghain says “gha”.",
      "title": "Ghain with fatha",
      "ar": "غَ",
      "aud": "c-2-ar"
    },
    {
      "en": "With a kasra, Ghain says “ghe”.",
      "title": "Ghain with kasra",
      "ar": "غِ",
      "aud": "c-3-ar"
    },
    {
      "en": "With a damma, Ghain says “gho”.",
      "title": "Ghain with damma",
      "ar": "غُ",
      "aud": "c-4-ar"
    },
    {
      "en": "“The room is clean”",
      "title": "Sentence of the lesson",
      "ar": "الغُرْفَةُ نَظِيفَة",
      "aud": "c-5-ar",
      "tr": "Al-Ghurfatu Nadhifa"
    }
