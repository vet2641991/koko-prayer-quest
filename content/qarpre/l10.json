  "learn": [
    {
      "en": "This is Daal. Like 'd' in 'door'. Tongue touches the upper teeth same position as English 'd'.",
      "title": "Meet Daal!",
      "ar": "د",
      "aud": "c-0-ar",
      "tr": "Daal"
    },
    {
      "en": "A small angular shape like a boomerang or a reverse tick. No dots. Dal looks like a DOOR from the side. 'D' for Door just like in English!",
      "title": "How to write Daal"
    },
    {
      "en": "With a fatha, Daal says “da”.",
      "title": "Daal with fatha",
      "ar": "دَ",
      "aud": "c-2-ar"
    },
    {
      "en": "With a kasra, Daal says “de”.",
      "title": "Daal with kasra",
      "ar": "دِ",
      "aud": "c-3-ar"
    },
    {
      "en": "With a damma, Daal says “do”.",
      "title": "Daal with damma",
      "ar": "دُ",
      "aud": "c-4-ar"
    },
    {
      "en": "“The lesson is excellent”",
