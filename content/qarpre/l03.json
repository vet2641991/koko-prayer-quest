  "learn": [
    {
      "en": "This is Alef. Like 'a' in 'apple' or the start of 'open'. A smooth throat sound",
      "title": "Meet Alef!",
      "ar": "أ",
      "aud": "c-0-ar",
      "tr": "Alef"
    },
    {
      "en": "One clean vertical stroke from top to bottom. The simplest letter in Arabic! Alef is the FIRST letter like 'A' in English. A tall standing figure!",
      "title": "How to write Alef"
    },
    {
      "en": "With a fatha, Alef says “a”.",
      "title": "Alef with fatha",
      "ar": "أَ",
      "aud": "c-2-ar"
    },
    {
      "en": "With a kasra, Alef says “e”.",
      "title": "Alef with kasra",
      "ar": "إِ",
      "aud": "c-3-ar"
    },
    {
      "en": "With a damma, Alef says “o”.",
      "title": "Alef with damma",
      "ar": "أُ",
      "aud": "c-4-ar"
    },
    {
      "en": "“I love the Arabic language”",
      "title": "Sentence of the lesson",
      "ar": "أَنَا أُحِبُّ اللُّغَةَ الْعَرَبِيَّة",
      "aud": "c-5-ar",
      "tr": "Ana Ohibbo Alloghata Al-Arabeyya"
    }
