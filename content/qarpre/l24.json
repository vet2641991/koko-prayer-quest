  "learn": [
    {
      "en": "This is Kaf. Like 'k' in 'key' or 'cat'. Back of tongue touches the soft palate a clear 'K' sound.",
      "title": "Meet Kaf!",
      "ar": "ك",
      "aud": "c-0-ar",
      "tr": "Kaf"
    },
    {
      "en": "Like a small L-shape with a diagonal mark inside — unique and easy to recognize! Kaf sounds like 'Key' K for Key! It opens many Arabic words!",
      "title": "How to write Kaf"
    },
    {
      "en": "With a fatha, Kaf says “ka”.",
      "title": "Kaf with fatha",
      "ar": "كَ",
      "aud": "c-2-ar"
    },
    {
      "en": "With a kasra, Kaf says “ke”.",
      "title": "Kaf with kasra",
      "ar": "كِ",
      "aud": "c-3-ar"
    },
    {
      "en": "With a damma, Kaf says “ko”.",
      "title": "Kaf with damma",
      "ar": "كُ",
      "aud": "c-4-ar"
    },
    {
      "en": "“The book is the best friend”",
