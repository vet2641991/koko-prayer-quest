  "minutes": 10,
  "learn": [
    {
      "en": "This is Ta (emphatic). Emphatic 'T' — heavier and deeper than regular Ta. The tongue presses the upper teeth hard.",
      "title": "Meet Ta (emphatic)!",
      "ar": "ط",
      "aud": "c-0-ar",
      "tr": "Ta (emphatic)"
    },
    {
      "en": "Like a loop with a long vertical stroke going up on the right side. Ta looks like a JUG or VESSEL with a handle. The emphatic version of Ta!",
      "title": "How to write Ta (emphatic)"
    },
    {
      "en": "With a fatha, heavy Ta says “ta”.",
      "title": "Ta (emphatic) with fatha",
      "ar": "طَ",
      "aud": "c-2-ar"
    },
    {
      "en": "With a kasra, heavy Ta says “te”.",
      "title": "Ta (emphatic) with kasra",
      "ar": "طِ",
      "aud": "c-3-ar"
    },
    {
      "en": "With a damma, heavy Ta says “to”.",
      "title": "Ta (emphatic) with damma",
      "ar": "طُ",
      "aud": "c-4-ar"
    },
    {
      "en": "“The food is delicious”",
      "title": "Sentence of the lesson",
      "ar": "الطَّعَامُ لَذِيذٌ",
      "aud": "c-5-ar",
      "tr": "Al-Ta'amu Ladhidh"
    }
  ],
