  "learn": [
    {
      "en": "This is Thaa. A soft th, like th in thin.",
      "title": "Meet Thaa!",
      "ar": "ث",
      "aud": "c-0-ar",
      "tr": "Thaa"
    },
    {
      "en": "Like a dish with three dots above. It connects from both sides.",
      "title": "How to write Thaa"
    },
    {
      "en": "Short vowels: listen and read.",
      "title": "Short vowels",
      "ar": "ثُلُثَ",
      "tr": "tholotha"
    },
    {
      "en": "Long vowels: listen and read.",
      "title": "Long vowels",
      "ar": "مَثُوبَةٍ",
      "tr": "mathoobaten"
    },
    {
      "en": "With Al: listen and read.",
      "title": "With Al",
      "ar": "ثَالِثُ",
      "tr": "thaaletho"
    },
    {
      "en": "Shaddah: listen and read.",
      "title": "Shaddah",
      "ar": "يَبُثُّ",
      "tr": "yaboththo"
    },
    {
      "en": "Tanween: listen and read.",
      "title": "Tanween",
      "ar": "حَرْثٌ",
      "tr": "harthon"
    },
    {
      "en": "Sukoon: listen and read.",
      "title": "Sukoon",
      "ar": "مِثْقَالَ",
      "tr": "methqaala"
    },
    {
      "en": "Surat Al-Baqarah, verse 233. Listen to Sheikh Al-Minshawi, then recite it yourself.",
      "title": "Quran Practice",
      "ar": "لَا تُضَآرَّ وَٰلِدَةٌۢ بِوَلَدِهَا وَلَا مَوْلُودٌۭ لَّهُۥ بِوَلَدِهِۦ ۚ وَعَلَى ٱلْوَارِثِ مِثْلُ ذَٰلِكَ",
      "aud": "c-8-ar"
    }
