  "title": {
    "ar": "حَرْفُ أَلِف",
    "en": "The Letter Alif and Hamza (أ)"
  },
  "topic": "Read Alif and Hamza with short vowels, long vowels, shaddah, tanween and sukoon, then recite from the Quran",
  "minutes": 15,
  "learn": [
    {
      "en": "This is Alif and Hamza. Alif has no sound. Hamza is a sharp catch in the throat.",
      "title": "Meet Alif and Hamza!",
      "ar": "أ",
      "aud": "c-0-ar",
      "tr": "Alif and Hamza"
    },
    {
      "en": "Alif is like a straight stick. Hamza is like a bird's head, and sometimes sits on alif, waw or yaa, or on the line. It connects to the right, but never to the left.",
      "title": "How to write Alif and Hamza"
    },
    {
      "en": "Hamza: listen and read.",
      "title": "Hamza",
      "ar": "أَنزَلْنَا",
      "tr": "anzalnaa"
    },
    {
      "en": "Short vowels: listen and read.",
      "title": "Short vowels",
      "ar": "أُمَّةٌ",
      "tr": "ommaton"
    },
    {
      "en": "Long vowels: listen and read.",
      "title": "Long vowels",
      "ar": "أُوتُوا",
      "tr": "ootoo"
    },
    {
      "en": "With Al: listen and read.",
      "title": "With Al",
      "ar": "ءَامَنَ",
      "tr": "aamana"
    },
    {
      "en": "Tanween: listen and read.",
      "title": "Tanween",
      "ar": "لُؤْلُؤٌ",
      "tr": "lo'lo'on"
    },
    {
      "en": "Sukoon: listen and read.",
      "title": "Sukoon",
      "ar": "يَأْمُرُ",
      "tr": "ya'moro"
    },
    {
      "en": "Surat Al-Baqarah, verse 93. Listen to Sheikh Al-Minshawi, then recite it yourself.",
      "title": "Quran Practice",
      "ar": "قُلْ بِئْسَمَا يَأْمُرُكُم بِهِۦٓ إِيمَٰنُكُمْ إِن كُنتُم مُّؤْمِنِينَ",
      "aud": "c-8-ar"
    }
  ],
