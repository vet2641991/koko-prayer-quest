  "minutes": 15,
  "learn": [
    {
      "en": "This is Seen. A light s, like s in snake.",
      "title": "Meet Seen!",
      "ar": "س",
      "aud": "c-0-ar",
      "tr": "Seen"
    },
    {
      "en": "Three teeth on the line like a fork, then a big bowl. It connects from both sides.",
      "title": "How to write Seen"
    },
    {
      "en": "Short vowels: listen and read.",
      "title": "Short vowels",
      "ar": "سُبُلًا",
      "tr": "sobolan"
    },
    {
      "en": "Long vowels: listen and read.",
      "title": "Long vowels",
      "ar": "رَسُولُ",
      "tr": "rasoolo"
    },
    {
      "en": "Now we read the name of the surah.",
      "title": "The surah",
      "ar": "سُورَةٌ",
      "aud": "c-4-ar",
      "tr": "sooraton"
    },
    {
      "en": "With Al: listen and read.",
      "title": "With Al",
      "ar": "سَاحِرٌ",
      "tr": "saaheron"
    },
    {
      "en": "Shaddah: listen and read.",
      "title": "Shaddah",
      "ar": "بِالسُّوٓءِ",
      "tr": "belssoo'e"
    },
    {
      "en": "Tanween: listen and read.",
      "title": "Tanween",
      "ar": "نَجَسٌ",
      "tr": "najason"
    },
    {
      "en": "Sukoon: listen and read.",
      "title": "Sukoon",
      "ar": "يَسْمَعُونَ",
      "tr": "yasma'oona"
    },
    {
      "en": "Surat Qaf, verse 40. Listen to Sheikh Al-Minshawi, then recite it yourself.",
      "title": "Quran Practice",
      "ar": "وَمِنَ ٱلَّيْلِ فَسَبِّحْهُ وَأَدْبَٰرَ ٱلسُّجُودِ",
      "aud": "c-9-ar"
    }
